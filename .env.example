# -----------------------------------------------------------------------------
# Environment Configuration Template
# -----------------------------------------------------------------------------

# Environment: development / production
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Backend Web Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omc_mgmt_tool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/omc_mgmt_tool

# Redis (Broker & Ephemeral Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Worker
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Shared Storage Paths
STORAGE_PATH=/app/storage
TEMPLATES_PATH=/app/storage/templates
UPLOADS_PATH=/app/storage/uploads
EXPORTS_PATH=/app/storage/exports
LOGS_PATH=/app/storage/logs

# Default Admin Seed Credentials
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=demo

